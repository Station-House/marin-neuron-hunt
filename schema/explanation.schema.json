{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marin neuron explanation",
  "description": "One file per neuron: explanations/L<layer>/L<layer>-N<neuron>.yaml. Both sides are required.",
  "type": "object",
  "additionalProperties": false,
  "required": ["neuron", "data", "label", "positive", "negative", "relation", "relation_note", "by"],
  "properties": {
    "neuron": {"$ref": "#/$defs/neuron"},
    "data": {"enum": ["pilot/fineweb-10m-sparse", "pilot/fineweb-1m", "pilot/stage-a-100k"]},
    "label": {"type": "string", "minLength": 1, "maxLength": 80, "description": "at most 8 words"},
    "positive": {"$ref": "#/$defs/side"},
    "negative": {"$ref": "#/$defs/side"},
    "relation": {"$ref": "#/$defs/relation"},
    "relation_note": {"type": "string", "minLength": 1},
    "by": {"$ref": "#/$defs/by"},
    "alternatives": {
      "type": "array",
      "description": "competing explanations, each with the request that would tell them apart",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "positive", "negative", "relation", "by", "discriminating_request"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "positive": {"$ref": "#/$defs/side"},
          "negative": {"$ref": "#/$defs/side"},
          "relation": {"$ref": "#/$defs/relation"},
          "relation_note": {"type": "string"},
          "by": {"$ref": "#/$defs/by"},
          "discriminating_request": {"type": "string", "pattern": "^L([0-9]|[1-5][0-9]|6[0-3])-N[0-9]{1,5}-[0-9]{3}$"}
        }
      }
    }
  },
  "$defs": {
    "neuron": {
      "type": "string",
      "description": "L<layer 0-63>-N<neuron 0-27647>",
      "pattern": "^L([0-9]|[1-5][0-9]|6[0-3])-N([0-9]{1,4}|1[0-9]{4}|2[0-6][0-9]{3}|27[0-5][0-9]{2}|276[0-3][0-9]|2764[0-7])$"
    },
    "relation": {"enum": ["variant", "cue-vs-absence", "lumped", "unrelated", "none"]},
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cue_type", "explanation", "fires_on", "not_on", "evidence", "verification"],
      "properties": {
        "status": {"enum": ["explained", "unclear", "silent", "no-own-job"]},
        "confidence": {"enum": ["high", "weak"]},
        "cue_type": {"enum": ["lexical", "subword", "grammar", "phrase-idiom", "semantic-topic", "discourse-structure", "format-markup", "code", "numeric-id", "next-token", "mixed", "none"]},
        "explanation": {"type": "string"},
        "fires_on": {"type": "string"},
        "not_on": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "verification": {"enum": ["untested", "requested", "confirmed", "refuted", "inconclusive"]}
      },
      "if": {"properties": {"status": {"const": "explained"}}},
      "then": {"required": ["confidence"], "properties": {"explanation": {"minLength": 1}, "evidence": {"minItems": 1}}}
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github", "method"],
      "properties": {
        "github": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"},
        "method": {"enum": ["human", "agent"]},
        "model": {"type": "string", "minLength": 1, "description": "the model or agent used; required when method is agent"}
      },
      "if": {"properties": {"method": {"const": "agent"}}},
      "then": {"required": ["model"]}
    },
    "by": {
      "description": "one person, or a list of people",
      "oneOf": [
        {"$ref": "#/$defs/person"},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/person"}}
      ]
    }
  }
}
